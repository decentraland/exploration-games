{
  "name": "exploration-games",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --trace-warnings --abort-on-uncaught-exception --unhandled-rejections=strict dist/index.js",
    "dev": "nodemon --watch 'src/**' --ext 'ts,json' --ignore 'src/**/*.spec.ts' --ignore 'src/migrations' --exec 'ts-node src/index.ts'",
    "test": "jest --forceExit --detectOpenHandles --coverage --verbose",
    "test:simple": "jest",
    "migrate": "node-pg-migrate --database-url-var PG_COMPONENT_PSQL_CONNECTION_STRING --envPath .env -j ts --tsconfig tsconfig.json -m ./src/migrations",
    "lint:check": "eslint '**/*.{js,ts}'",
    "lint:fix": "eslint '**/*.{js,ts}' --fix"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.1.1",
    "@dcl/test-helpers": "^0.3.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "tabWidth": 2
  },
  "dependencies": {
    "@dcl/core-commons": "^0.10.1",
    "@dcl/crypto": "^3.7.0",
    "@dcl/crypto-middleware": "^6.3.0",
    "@dcl/fetch-component": "^1.1.1",
    "@dcl/http-commons": "^2.0.0",
    "@dcl/http-server": "^2.1.0",
    "@dcl/metrics": "^1.0.1",
    "@dcl/pg-component": "^0.2.0",
    "@well-known-components/env-config-provider": "^1.2.0",
    "@well-known-components/interfaces": "^1.5.2",
    "@well-known-components/logger": "^3.1.3",
    "cron": "^3.1.7",
    "joi": "^17.13.3",
    "node-pg-migrate": "^7.9.1",
    "sql-template-strings": "^2.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
